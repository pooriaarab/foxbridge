{
  "name": "foxbridge",
  "version": "0.1.5",
  "description": "Connect MCP agents to shared Firefox tabs with a native messaging host, page snapshots, browser actions, and sidebar approvals.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxbridge.git"
  },
  "homepage": "https://github.com/pooriaarab/foxbridge#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "foxbridge": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:ext && pnpm lint:ext && pnpm check:amo",
    "build:ext": "node scripts/build-ext.mjs",
    "lint:ext": "web-ext lint -s dist-ext --warnings-as-errors",
    "check:amo": "node scripts/amo-listing.mjs check",
    "e2e": "pnpm build && pnpm build:ext && node e2e/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "create-foxkit": "^0.1.0",
    "esbuild": "^0.28.2",
    "foxgate": "^0.1.0",
    "foxloop": "^0.1.0",
    "foxpaw": "^0.1.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  },
  "keywords": [
    "Firefox",
    "MCP",
    "native-messaging",
    "browser-automation",
    "Claude Code",
    "TypeScript",
    "foxpaw",
    "foxloop",
    "foxgate",
    "approval",
    "shared-tabs",
    "stdio"
  ]
}
