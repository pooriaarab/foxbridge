{
  "manifest_version": 3,
  "name": "foxbridge — share tabs with your coding agent",
  "version": "0.1.2",
  "description": "Let outside agents such as Claude Code use the tabs you share, through MCP.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxbridge@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  },
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_title": "foxbridge"
  },
  "sidebar_action": {
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_title": "foxbridge",
    "default_panel": "sidebar.html",
    "open_at_install": false
  }
}
